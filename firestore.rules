rules_version = '2';

// Regras de segurança do Partitura Live.
//  users/{uid}            dados privados (progresso, preferências) — só o dono
//  users/{uid}/songs      músicas importadas — só o dono
//  users/{uid}/inbox      mensagens recebidas — o dono lê/apaga/marca lida; amigos podem criar
//  profiles/{uid}         resumo público — qualquer usuário logado lê UM perfil (sem listar); só o dono escreve
//  friendCodes/{code}     código de amigo -> uid — consulta por código (sem listar)
//  friendRequests/{a_b}   pedido de a para b
//  friendships/{a_b}      amizade (uids em ordem alfabética)
//  chats/{a_b}            conversa entre dois amigos (resumo, leitura, digitando)
//  chats/{a_b}/messages   mensagens da conversa
//  library/{id}           biblioteca compartilhada: resumo da música (todos com conta leem; só quem enviou altera)
//  libraryData/{id}       partitura compactada da música compartilhada
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isFriend(other) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(me(), other)));
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    function optShortString(data, field, max) {
      return !(field in data) || data[field] == null || shortString(data[field], max);
    }

    // ---------- dados privados ----------
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;

      match /songs/{songId} {
        allow read, write: if signedIn() && me() == uid;
      }

      match /inbox/{msgId} {
        allow read, delete: if signedIn() && me() == uid;
        // o dono só pode marcar como lida
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // amigos enviam mensagens assinadas por eles mesmos
        allow create: if signedIn()
          && me() != uid
          && isFriend(uid)
          && request.resource.data.from == me()
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'fromPhoto', 'fromAvatar', 'type', 'text', 'songId', 'songTitle', 'score', 'data', 'createdAt', 'read'])
          && request.resource.data.type in ['cheer', 'challenge', 'song', 'text']
          && shortString(request.resource.data.fromName, 60)
          && optShortString(request.resource.data, 'text', 300)
          && optShortString(request.resource.data, 'songTitle', 160)
          && optShortString(request.resource.data, 'songId', 200)
          && request.resource.data.read == false;
      }
    }

    // ---------- perfil público ----------
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.uid == uid
        && shortString(request.resource.data.name, 60)
        && shortString(request.resource.data.code, 12);
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- código de amigo ----------
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // só cria (não sobrescreve código de outra pessoa)
      allow create: if signedIn() && request.resource.data.uid == me() && code.size() == 6;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---------- pedidos de amizade (id = remetente_destinatário) ----------
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && shortString(request.resource.data.fromName, 60);
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // ---------- amizades ----------
    match /friendships/{id} {
      allow read: if signedIn() && me() in resource.data.members;
      // quem recebeu o pedido aceita; o pedido precisa existir
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && id == pairId(request.resource.data.members[0], request.resource.data.members[1])
        && exists(/databases/$(database)/documents/friendRequests/$(
             (request.resource.data.members[0] == me() ? request.resource.data.members[1] : request.resource.data.members[0]) + '_' + me()));
      allow delete: if signedIn() && me() in resource.data.members;
    }

    // ---------- conversas (id = uids em ordem alfabética) ----------
    match /chats/{chatId} {
      function parts() {
        return chatId.split('_');
      }
      function isMember() {
        return signedIn() && parts().size() == 2 && me() in parts() && chatId == pairId(parts()[0], parts()[1]);
      }
      function other() {
        return parts()[0] == me() ? parts()[1] : parts()[0];
      }
      // cada um só mexe na própria entrada dos mapas (sent, seen, typing…)
      function ownEntry(field, changed) {
        return !(field in changed)
          || (request.resource.data[field] is map
              && request.resource.data[field].diff(resource == null ? {} : resource.data.get(field, {})).affectedKeys().hasOnly([me()]));
      }
      function validChat(changed) {
        return ownEntry('sent', changed) && ownEntry('seen', changed) && ownEntry('seenAt', changed)
          && ownEntry('typing', changed) && ownEntry('here', changed)
          // mensagem enviada: o contador sobe de 1 em 1 e a prévia é de quem enviou
          && (!('sent' in changed)
              || request.resource.data.sent[me()] == (resource == null ? 0 : resource.data.get('sent', {}).get(me(), 0)) + 1)
          && (!('last' in changed)
              || (request.resource.data.last.from == me() && shortString(request.resource.data.last.text, 200)));
      }

      allow read: if signedIn() && me() in resource.data.members;
      allow create: if isMember() && isFriend(other())
        && request.resource.data.members == [parts()[0], parts()[1]]
        && request.resource.data.keys().hasOnly(['members', 'updatedAt', 'last', 'sent', 'seen', 'seenAt', 'typing', 'here'])
        && validChat(request.resource.data.keys());
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'last', 'sent', 'seen', 'seenAt', 'typing', 'here'])
        && validChat(request.resource.data.diff(resource.data).affectedKeys())
        // conversar exige amizade; marcar como lida, não
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'here', 'typing']) || isFriend(other()));
      allow delete: if isMember();

      match /messages/{msgId} {
        allow read: if isMember();
        allow create: if isMember() && isFriend(other())
          && request.resource.data.from == me()
          && request.resource.data.keys().hasOnly(['from', 'type', 'text', 'songId', 'songTitle', 'score', 'data', 'at'])
          && request.resource.data.type in ['text', 'cheer', 'challenge', 'song', 'result']
          && request.resource.data.at == request.time
          && optShortString(request.resource.data, 'text', 1000)
          && optShortString(request.resource.data, 'songTitle', 160)
          && optShortString(request.resource.data, 'songId', 200);
        // reações: cada um só a sua
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()])
          && (!(me() in request.resource.data.reactions) || shortString(request.resource.data.reactions[me()], 16));
        // qualquer um dos dois pode apagar (apagar a conversa vale para os dois)
        allow delete: if isMember();
      }
    }
      // ---------- biblioteca compartilhada ----------
    match /library/{songId} {
      function validMeta() {
        let d = request.resource.data;
        return d.keys().hasOnly(['title', 'composer', 'level', 'hands', 'measures', 'fileName', 'ownerUid', 'ownerName', 'createdAt'])
          && d.ownerUid == me()
          && shortString(d.title, 160)
          && optShortString(d, 'composer', 160)
          && optShortString(d, 'fileName', 200)
          && shortString(d.ownerName, 60)
          && d.level is int && d.level >= 1 && d.level <= 5
          && d.hands in ['R', 'L', 'RL']
          && d.measures is int;
      }
      allow read: if signedIn();
      allow create: if signedIn() && songId.size() <= 200 && validMeta();
      allow update: if signedIn() && resource.data.ownerUid == me() && validMeta();
      allow delete: if signedIn() && resource.data.ownerUid == me();
    }
    match /libraryData/{songId} {
      allow read: if signedIn();
      allow create: if signedIn() && songId.size() <= 200
        && request.resource.data.keys().hasOnly(['ownerUid', 'data', 'createdAt'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 950000;
      allow update: if signedIn() && resource.data.ownerUid == me()
        && request.resource.data.keys().hasOnly(['ownerUid', 'data', 'createdAt'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.data is bytes;
      allow delete: if signedIn() && resource.data.ownerUid == me();
    }
  }
}
